# =============================================================================
# Important — local vs production
# -----------------------------------------------------------------------------
# Ce fichier sert de référence. Les secrets et les overrides machine ne doivent
# pas être commités : utiliser frontend/.env.local (déjà dans .gitignore).
#
# Local : copier .env.local.example → .env.local et lancer Django sur le port 8000.
#         Sans .env.local, Next peut deviner http://HOST:8000 côté navigateur, mais
#         si NEXT_PUBLIC_API_URL est défini (CI, autre .env), il prévaut toujours.
#
# Production (Vercel, etc.) : définir NEXT_PUBLIC_API_URL et NEXT_PUBLIC_SITE_URL
# dans l’interface d’hébergement — jamais se fier à un .env.local déployé.
# =============================================================================

# ID de la vidéo YouTube pour le fond de la landing
# Ex: https://youtube.com/watch?v=abc123 → renseigner seulement l'ID : abc123
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=eZhq_RMYRKQ

# ID de la vidéo YouTube cyclique pour la page Explore (aftermovie)
# Ex: https://www.youtube.com/watch?v=yaGM4tF42Jk → renseigner seulement l'ID : yaGM4tF42Jk
NEXT_PUBLIC_YOUTUBE_CYCLE_VIDEO_ID=eZhq_RMYRKQ

# URL de base de l'API backend (Django), sans slash final.
# En local : surcharger dans .env.local — voir .env.local.example (127.0.0.1:8000).
# En prod : URL Railway (ou domaine API) configurée sur l’hébergeur front.
NEXT_PUBLIC_API_URL=https://capitaloffusionversion5-production.up.railway.app

# URL du site (pour SEO : sitemap, Open Graph, robots)
# En prod : https://ton-domaine.fr
NEXT_PUBLIC_SITE_URL=https://capitaloffusion.fr

# (Optionnel) Client ID Google OAuth pour « Se connecter avec Google »
# Créer des identifiants « Application Web » dans Google Cloud Console → APIs & Services → Credentials
# Origines autorisées : http://localhost:3000 (dev), https://ton-domaine.vercel.app (prod)
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
