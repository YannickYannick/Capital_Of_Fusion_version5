# Template pour le développement local (sans secret).
# Copier vers .env.local à la racine de frontend/ :
#   copy .env.local.example .env.local   (Windows)
#
# Port 8000 : Django Bachata par défaut.
# Si un autre projet occupe déjà 8000 (tu vois des 404 sur /api/menu/), utilise 8001 :
#   cd backend && python manage.py runserver 127.0.0.1:8001
#   puis mets la ligne ci-dessous sur ...:8001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
